PORT=4000
HOST=0.0.0.0

# Required after `npm run deploy:local` (copied into .env.local).
# The API is an Anvil adapter. Missing RPC or hook addresses → 503 deploy_local.
ORACLE_RPC_URL=http://127.0.0.1:8545
ORACLE_CHAIN_ID=31337
COMPLIANCE_ORACLE_ADDRESS=0x...
AML_HOOK_ADDRESS=0x...
FEE_ESCROW_ADDRESS=0x...
FEE_TOKEN_ADDRESS=0x...
USD_FEED_ADDRESS=0x...
ETH_USD_FEED_ADDRESS=0x...

# Anvil #0 — must hold AccessManager _ORACLE_KEEPER (role id 2)
KEEPER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Anvil #9 — Deploy local attestor. Signs attestationHash. Empty sig is rejected.
ATTESTOR_PRIVATE_KEY=0x2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6

# Quotes always go through AmlHook.previewSwap. There is no memory fallback.
SCORE_SOURCE=onchain

# Keeper heartbeat: recompute scores from the oracle record and stamp
# ComplianceOracle.updatedAt. Default 180000 ms (3 min). KEEPER_TICK=0 disables.
# KEEPER_TICK_MS=180000
# KEEPER_TICK=0

# Live COA (Claude). Put the real key in apps/api/.env — never in this file,
# never in .env.local (deploy:local overwrites .env.local).
# Seed, transfer, afterSwap, and block wait for Claude to emit score + fee +
# Opinion. The keeper writes ComplianceOracle; the hook and FeeEscrow read it.
# Tick (3 min) only stamps the last score. COA_LIVE=0 uses the skill interpreter.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# COA_LIVE=0
